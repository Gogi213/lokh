{
  "policyGlobs": [
    "docs/Agents/Roles/*.md",
    ".agents/skills/*/SKILL.md",
    ".agents/skills/*/agents/*.yaml",
    "apps/AGENTS.md",
    "apps/**/AGENTS.md",
    "apps/*/docs/agents/*ROUTER*.md",
    "apps/*/docs/agents/roles/*.md",
    "apps/*/docs/Agents/*Router.md",
    "apps/*/docs/Agents/Roles/*.md",
    "apps/*/tools/Codex/skills/*/SKILL.md",
    "apps/*/tools/Codex/skills/*/agents/*.yaml"
  ],
  "rules": [
    {"id": "global-entrypoint", "path": "AGENTS.md", "triggers": ["always"], "requiredText": ["docs/Agents/DevelopmentWorkflow.md", "docs/Agents/PlanWorkflow.md", "docs/Agents/Subagents.md", "docs/Agents/GlobalContracts.md", "docs/Agents/HotPathFastLane.md", "docs/Agents/RoleRouter.md", "docs/Agents/ReportFormat.md", "docs/Agents/Superpowers.md"]},
    {"id": "development-workflow", "path": "docs/Agents/DevelopmentWorkflow.md", "triggers": ["code-change", "new-behavior", "bugfix", "refactor", "TDD", "tests"], "requiredText": ["Test-first is optional", "wait for user selection before execution", "делай и проверь", "A message does not transfer ownership", "Changed commands or targets", "First approval is required before launching a check package", "The approved package remains authorized until task completion", "Classify by effects", "Lightweight local checks", "Native build checks"]},
    {"id": "global-contracts", "path": "docs/Agents/GlobalContracts.md", "triggers": ["public-contract", "public-header", "ABI", "schema", "dependency", "ownership", "cross-module", "structure", "bounded-storage", "compiler", "target-profile"], "requiredText": ["V<number>", "One semantic rule", "each exchange implementation atomic", "cxet::StringView", "simdjson", "Boost", "absl::InlinedVector", "std::vector", "-Wframe-larger-than=32768", "/mnt/d/recordings", "Strategy.hpp"]},
    {"id": "role-routing", "path": "docs/Agents/RoleRouter.md", "triggers": ["role-selection", "uncertain-ownership", "code-simplicity"], "requiredText": ["code_simplicity_engineer", "low_latency_engineer", "hot_parser_engineer", "hot_transport_engineer", "trader_runtime_engineer", "strategy_quant", "observability_engineer", "network_placement_engineer", "architect"]},
    {"id": "code-simplicity-role", "path": "docs/Agents/Roles/CodeSimplicityEngineer.md", "triggers": ["code-simplicity", "boilerplate", "code_simplicity_engineer"], "requiredText": ["## Mission and assignment modes", "## Safety and evidence"]},
    {"id": "hot-path-fast-lane", "path": "docs/Agents/HotPathFastLane.md", "triggers": ["src/src/Core/**", "src/src/Contracts/**", "apps/trading-core/**", "apps/hft-parser/**", "apps/trader/**", "latency", "parser", "transport", "readiness", "order-send"], "requiredText": ["current registered normalized runtime/tape payload contract", "terminal TLS/socket write", "Order-book deltas", "simd", "degraded/recovery semantics", "low_latency_engineer"]},
    {"id": "subagents", "path": "docs/Agents/Subagents.md", "triggers": ["subagent", "worker", "explorer", "reviewer", "parallel", "delegate", "model-routing", "code-simplicity", "boilerplate", "mandatory-hot-review", "capital-computation-review"], "requiredText": ["configured native session limit", "non-overlapping file ownership", "done_unverified", "Model routing (canonical)", "gpt-6.1-terra", "gpt-6.1-sol", "`code_simplicity_engineer`", "For the final integrated H0/H1 code change, run two independent read-only reviews", "`low_latency_engineer`", "one relevant specialist", "`strategy_quant` + `low_latency_engineer` pair already during its offline stage", "mechanical_luna", "mechanical_luna_broad", "Fast mode may be selected manually"]},
    {"id": "durable-plans", "path": "docs/Agents/PlanWorkflow.md", "triggers": ["составь план", "выполни план", "implement the plan", "проверь план", "plan.md", "state.json"], "requiredText": ["single current", "active task", "planSha256", "done_unverified", "A worker report is a claim", "exact user-selected verification commands"]},
    {"id": "plan-mode-goals", "path": "docs/Agents/PlanWorkflow.md", "triggers": ["plan-mode", "Shift+Tab", "goal", "get_goal", "create_goal", "approved-plan-execution"], "requiredText": ["Plan mode does not create or mutate a Goal", "Goal does not grant permission", "get_goal", "create_goal"]},
    {"id": "reporting", "path": "docs/Agents/ReportFormat.md", "triggers": ["non-trivial-report", "review", "audit"], "requiredText": ["static-only", "build proof", "targeted-test proof", "runtime proof", "live proof", "done_unverified"]},
    {"id": "superpowers", "path": "docs/Agents/Superpowers.md", "triggers": ["superpowers"], "requiredText": ["DevelopmentWorkflow.md", "PlanWorkflow.md", "Runtime/live actions require separate exact task-scoped authorization", "even when listed in a plan"]},
    {"id": "agent-system-overview", "path": "docs/Agents/README.md", "triggers": ["agent-system-overview"], "requiredText": ["explicit user instructions", "canonical owner"]},
    {"id": "rule-index", "path": "docs/Agents/RuleIndex.json", "triggers": ["rule-index"], "requiredText": ["docs/Agents/Subagents.md"]},
    {"id": "agent-routing-data", "path": "tools/Codex/AgentRouting.json", "triggers": ["model-routing"], "requiredText": ["gpt-6.1-sol"]},
    {"id": "skill-evals", "path": "tools/Codex/SkillEvals.yaml", "triggers": ["skill-evals"], "requiredText": ["reasoningEffort"]},
    {"id": "aws", "path": "docs/Agents/AwsWorkflow.md", "triggers": ["aws", "bedrock", "cdk", "cloudformation", "lambda", "ecs", "secret", "credential", "api-key", "token", "password"], "requiredText": ["aws-secrets-manager", "get-secret-value", "asm-exec", "Well-Architected"]},
    {"id": "hft-parser-local", "path": "apps/hft-parser/AGENTS.md", "triggers": ["apps/hft-parser/**"]},
    {"id": "hft-recorder-local", "path": "apps/hft-recorder/AGENTS.md", "triggers": ["apps/hft-recorder/**"]},
    {"id": "apps-entrypoint", "path": "apps/AGENTS.md", "triggers": ["apps/**"]},
    {"id": "diagnostic-local", "path": "apps/diagnostic/AGENTS.md", "triggers": ["apps/diagnostic/**"]},
    {"id": "hft-backtest-local", "path": "apps/hft-backtest/AGENTS.md", "triggers": ["apps/hft-backtest/**"]},
    {"id": "hft-compressor-local", "path": "apps/hft-compressor/AGENTS.md", "triggers": ["apps/hft-compressor/**"]},
    {"id": "trader-local", "path": "apps/trader/AGENTS.md", "triggers": ["apps/trader/**"]},
    {"id": "trading-core-local", "path": "apps/trading-core/AGENTS.md", "triggers": ["apps/trading-core/**"]},
    {"id": "capital-local", "path": "apps/trading-core/capital/AGENTS.md", "triggers": ["apps/trading-core/capital/**", "capital", "капитал"]},
    {"id": "vetron-local", "path": "apps/vetron/AGENTS.md", "triggers": ["apps/vetron/**"]},
    {"id": "parser-role-router", "path": "apps/hft-parser/docs/agents/ROLE_ROUTER.md", "triggers": ["role-routing", "apps/hft-parser/**"]},
    {"id": "recorder-role-router", "path": "apps/hft-recorder/docs/Agents/RoleRouter.md", "triggers": ["role-routing", "apps/hft-recorder/**"]}
  ]
}
