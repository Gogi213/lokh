+    q = ",".join("?" * len(mine))
+    df = {r[0]: r[1] for r in con.execute(
+        f"SELECT tag_id, COUNT(*) FROM record_tags WHERE tag_id IN ({q}) GROUP BY tag_id", list(mine))}
+    wt = {t: math.log(n / df[t]) * (0.3 if mine[t] == "coll" else 1.0) for t in mine if t in df}
